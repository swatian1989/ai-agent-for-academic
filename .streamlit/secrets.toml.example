# ─── Secrets for the ONLINE app (Streamlit Community Cloud) ─────────────────────────────────
# Paste these lines into: share.streamlit.io → your app → ⋮ → Settings → Secrets  (or "Advanced
# settings" while deploying). Never put real keys in GitHub — this example file has none.

# Tells the app it is hosted: keys stay in each visitor's browser session, each visitor gets a
# private temporary workspace, and nothing is written to the shared .env.
AI_AGENT_CLOUD = "1"

# Which AI the app starts with: "anthropic" (Claude, paid) | "gemini" (FREE key) | "openrouter" (FREE models)
# Every visitor can still switch provider and paste their own key in ⚙️ Settings.
AI_PROVIDER = "gemini"

# Option A — FREE for everyone: put YOUR free Google Gemini key here (https://aistudio.google.com/apikey).
#   Google's free daily limit is then shared by all users, and Google may use the text to improve its products.
GEMINI_API_KEY = ""

# Option B — everyone uses YOUR Anthropic key (you pay). Set AI_PROVIDER = "anthropic" and a password.
ANTHROPIC_API_KEY = ""

# Option C — leave all keys empty: each visitor pastes their own key (free Gemini/OpenRouter or Claude).

APP_PASSWORD = ""                    # recommended whenever one of YOUR keys is set above

CLAUDE_MODEL = "claude-opus-5-5"     # or "claude-sonnet-5-5" (about half the price)
CLAUDE_BULK_MODEL = ""
SEMANTIC_SCHOLAR_API_KEY = ""        # free key recommended: https://www.semanticscholar.org/product/api
NCBI_EMAIL = ""                      # your email, for PubMed
