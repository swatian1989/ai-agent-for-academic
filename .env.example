# Copy this file to .env and fill in your keys (the app's ⚙️ Settings panel does this for you).
# Never share or upload .env — it is listed in .gitignore.

# Which AI writes: anthropic (Claude, paid, best) | gemini (Google, FREE key) | openrouter (FREE models)
AI_PROVIDER=anthropic

# Claude (paid): https://console.anthropic.com/ → API keys
ANTHROPIC_API_KEY=

# Google Gemini (FREE key, no card): https://aistudio.google.com/apikey
# On the free tier Google may use what you send to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter (FREE models, about 50 requests/day): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Model for writing and critique (default claude-opus-5-5). claude-sonnet-5-5 is about half the price.
CLAUDE_MODEL=claude-opus-5-5

# Optional: a cheaper model just for bulk screening/extraction (leave empty to use CLAUDE_MODEL)
CLAUDE_BULK_MODEL=

# Recommended: free Semantic Scholar API key - anonymous access is often rate-limited (HTTP 429)
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Optional but polite for PubMed E-utilities (NCBI asks for an email; an API key raises the rate limit)
NCBI_EMAIL=
NCBI_API_KEY=
